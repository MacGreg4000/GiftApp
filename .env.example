# Copier vers .env et remplacer CHAQUE secret avant d'ouvrir le site sur Internet.
#   cp .env.example .env && chmod 600 .env
# Générer des secrets :
#   openssl rand -base64 48          # PIN_PEPPER
#   openssl rand -hex 32             # TOTP_KEY
#   openssl rand -base64 24          # DB_PASSWORD

DB_PASSWORD=changez-moi
PIN_PEPPER=changez-moi-au-moins-32-caracteres-aleatoires
TOTP_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ORIGIN=https://cadeaux.exemple.be
ADMIN_PATH=/gestion-changez-moi
# Laisser vide pour qu'un code s'affiche dans les journaux au premier démarrage.
SETUP_TOKEN=
# Nom de l'en-tête lu par l'application (défaut x-forwarded-for).
# Ne pas confondre avec la variable SvelteKit du même nom : elle n'est pas
# passée au conteneur, pour que le healthcheck et l'accès direct fonctionnent.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
PROTOCOL_HEADER=X-Forwarded-Proto
HOST_HEADER=X-Forwarded-Host
# Notifications web, facultatives. Générer une paire :
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@exemple.be

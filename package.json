{
	"name": "nos-souhaits",
	"version": "1.0.0",
	"description": "Nos Souhaits — listes de cadeaux familiales auto-hébergées",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/lib/server/db/migrate-cli.ts",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:db": "vitest run tests/integration"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/qrcode": "^1.5.5",
		"@types/web-push": "^3.6.4",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@fontsource/figtree": "^5.3.0",
		"@fontsource/fraunces": "^5.3.0",
		"@node-rs/argon2": "^2.2.2",
		"@sveltejs/adapter-node": "^6.0.2",
		"drizzle-orm": "^0.45.4",
		"otpauth": "^9.6.0",
		"postgres": "^3.4.7",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"web-push": "^4.0.0",
		"zod": "^3.25.76"
	}
}
